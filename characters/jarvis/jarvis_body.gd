extends Node2D
## JARVIS drone look: an animated shell (spinning rotor + thruster flicker) with a face shown on
## its screen. Art is generated by assets/jarvis/generate_jarvis_sprites.gd. The parent bobs,
## tilts, flips and tints this node; this node only animates the sprites.

@export var body_texture: Texture2D = preload("res://assets/jarvis/body.png")
@export var faces_texture: Texture2D = preload("res://assets/jarvis/faces.png")
@export var frame_size: int = 32
## Face frame names in faces.png order (must match the generator's FACES order).
@export var face_names: PackedStringArray = ["neutral", "blink", "happy", "annoyed", "off", "furious"]
## body.png: spinning frames first, then one powered-down frame (rotor stopped, no flame).
@export var off_frames: int = 1
@export var rotor_fps: float = 14.0
@export var blink_interval_min: float = 2.5
@export var blink_interval_max: float = 5.0
@export var blink_duration: float = 0.12
## 0..1; below this power the rotor shows the stopped frame.
@export var stopped_below_power: float = 0.15

## 1 = running, 0 = powered down. The parent eases this when JARVIS goes offline/online.
var power: float = 1.0

var face: String = "neutral"

var _shell := Sprite2D.new()
var _face := Sprite2D.new()
var _rotor_time: float = 0.0
var _blink_left: float = 0.0
var _blink_time_left: float = 0.0


func _ready() -> void:
	for sprite: Sprite2D in [_shell, _face]:
		sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		add_child(sprite)
	_shell.texture = body_texture
	_shell.hframes = maxi(body_texture.get_width() / frame_size, 1)
	_face.texture = faces_texture
	_face.hframes = maxi(faces_texture.get_width() / frame_size, 1)
	_blink_left = randf_range(blink_interval_min, blink_interval_max)
	set_face(face)


## Shows a face by name (see face_names). Unknown names fall back to the first face.
func set_face(face_name: String) -> void:
	face = face_name
	_show_face(face_name)


func _process(delta: float) -> void:
	var spinning := maxi(_shell.hframes - off_frames, 1)
	if power < stopped_below_power:
		_shell.frame = spinning # first off frame
	else:
		_rotor_time += delta * power # spins down with power
		_shell.frame = int(_rotor_time * rotor_fps) % spinning
	_tick_blink(delta)


func _tick_blink(delta: float) -> void:
	if not face_names.has("blink") or face != "neutral":
		return
	if _blink_time_left > 0.0:
		_blink_time_left -= delta
		if _blink_time_left <= 0.0:
			_show_face(face)
		return
	_blink_left -= delta
	if _blink_left <= 0.0:
		_blink_left = randf_range(blink_interval_min, blink_interval_max)
		_blink_time_left = blink_duration
		_show_face("blink")


func _show_face(face_name: String) -> void:
	_face.frame = clampi(maxi(face_names.find(face_name), 0), 0, _face.hframes - 1)
