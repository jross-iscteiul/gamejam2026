@tool
extends Hazard
## Giant robot hand lurking at the bottom of a pit. The moment the player is anywhere over the pit
## they freeze, the hand bursts up the middle of it on its chain with no warning and yanks them into
## its fist (screen shake + clank). There is no escape: they are dragged down and killed
## `death_delay` seconds later. Origin = centre of the pit at the height of its rim.

enum State { IDLE, RISE, CLOSE, PULL, COOLDOWN }

## Pit width: the player anywhere over it is caught.
@export var width := 128.0
## Distance from the rim down to the pit bottom, where the hand hides; everything below is clipped.
@export var depth := 160.0
## How far above the rim the player is caught; stop it below any platform over the pit.
@export var reach_up := 320.0
@export var rise_time := 0.2
@export var close_time := 0.15
@export var cooldown := 1.5
## Seconds from the grab until the player dies.
@export_range(1.0, 2.0) var death_delay := 1.5

## Frames: open, half closed, fist. Generated by assets/hazards/generate_grab_hand_sprite.gd.
const SPRITE := preload("res://assets/hazards/grab_hand.png")
const CHAIN := preload("res://assets/hazards/grab_hand_chain.png")
const FRAMES := 3
## Sprite pixel (inside a frame) at the centre of the palm's top edge.
const PALM_TOP := Vector2(32, 36)
## How far the open fingers reach above the palm top, and the cuff below it.
const REACH := 34.0
const CUFF_BOTTOM := 28.0
## Palm top height above the rim when fully risen.
const RISE_HEIGHT := 40.0
## How far below the rim a falling player still counts.
const ZONE_DOWN := 24.0
## Player collision half width: only a player whose centre is over the pit gets caught.
const PLAYER_HALF_W := 6.0
## Held player stays this far above the pit bottom (player half height + margin).
const PIT_CLEARANCE := 24.0
## Held player's offset from the palm top (centre of the fist).
const GRIP := 2.0
const PULL_TIME := 0.6

static var _clank: AudioStreamWAV

var state := State.IDLE
var _state_time := 0.0
var _zone: Area2D
var _hand: Sprite2D
var _victim: Player
## Where the victim froze, relative to the hand origin; it is yanked from there into the fist.
var _caught_at := Vector2.ZERO


func _ready() -> void:
	if Engine.is_editor_hint():
		return
	_zone = Area2D.new()
	_zone.name = "GrabZone"
	_zone.collision_layer = 0
	_zone.collision_mask = PLAYER_LAYER
	_zone.monitorable = false
	var shape := CollisionShape2D.new()
	shape.shape = rect(Vector2(width - 2.0 * PLAYER_HALF_W, reach_up + ZONE_DOWN))
	shape.position = Vector2(0, (ZONE_DOWN - reach_up) / 2.0)
	_zone.add_child(shape)
	add_child(_zone)
	var side := width / 2.0 + 64.0
	var mask := Polygon2D.new()
	mask.polygon = PackedVector2Array([Vector2(-side, -200), Vector2(side, -200), Vector2(side, depth), Vector2(-side, depth)])
	mask.clip_children = CanvasItem.CLIP_CHILDREN_ONLY
	add_child(mask)
	_hand = Sprite2D.new()
	_hand.texture = SPRITE
	_hand.hframes = FRAMES
	_hand.centered = false
	_hand.offset = -PALM_TOP
	mask.add_child(_hand)
	var chain := Sprite2D.new()
	chain.texture = CHAIN
	chain.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
	chain.region_enabled = true
	chain.region_rect = Rect2(0, 0, CHAIN.get_width(), depth + RISE_HEIGHT)
	chain.centered = false
	chain.position = Vector2(-CHAIN.get_width() / 2.0, CUFF_BOTTOM)
	_hand.add_child(chain)
	_update_hand()


func _physics_process(delta: float) -> void:
	if Engine.is_editor_hint():
		return
	_state_time += delta
	match state:
		State.IDLE:
			var player := _player_in_zone()
			if player and player.seize(true):
				_victim = player
				_caught_at = to_local(player.global_position)
				_enter(State.RISE)
		State.RISE:
			if _state_time >= rise_time / difficulty:
				if is_instance_valid(_victim) and _victim.held:
					_victim.conceal()
					_impact()
				_enter(State.CLOSE)
		State.CLOSE:
			if _state_time >= close_time:
				_enter(State.PULL)
		State.PULL:
			if _state_time >= death_delay:
				if is_instance_valid(_victim) and _victim.held:
					_victim.respawn()
				_victim = null
				_enter(State.COOLDOWN)
		State.COOLDOWN:
			if _state_time >= cooldown / difficulty:
				_enter(State.IDLE)
	if is_instance_valid(_victim) and _victim.held:
		var fist := Vector2(0, -extension() + GRIP)
		if state == State.RISE:
			fist = _caught_at.lerp(fist, _rise_progress())
		# Stay above the pit's own kill trigger, or it respawns the victim a second time.
		fist.y = minf(fist.y, depth - PIT_CLEARANCE)
		_victim.global_position = to_global(fist)
	_update_hand()


func _update_hand() -> void:
	_hand.position.y = -extension()
	_hand.frame = mini(int(closure() * FRAMES), FRAMES - 1)


## Palm top height above the rim (negative = below).
func extension() -> float:
	var hidden := -(depth + REACH + 2.0)
	match state:
		State.RISE:
			return lerpf(hidden, RISE_HEIGHT, _rise_progress())
		State.CLOSE:
			return RISE_HEIGHT
		State.PULL:
			return lerpf(RISE_HEIGHT, hidden, ease(minf(_state_time / PULL_TIME, 1.0), 1.8))
	return hidden


func _rise_progress() -> float:
	return ease(minf(_state_time / (rise_time / difficulty), 1.0), 0.4)


## 0 = open hand, 1 = closed fist.
func closure() -> float:
	match state:
		State.CLOSE:
			return minf(_state_time / close_time, 1.0)
		State.PULL:
			return 1.0
	return 0.0


func _enter(next: State) -> void:
	state = next
	_state_time = 0.0


func _player_in_zone() -> Player:
	for body in _zone.get_overlapping_bodies():
		# Overlaps lag a physics frame: re-check where the player is now (e.g. just respawned).
		var p := to_local(body.global_position)
		if body is Player and absf(p.x) <= width / 2.0 and p.y >= -reach_up - 16.0 and p.y <= ZONE_DOWN + 16.0:
			return body
	return null


func _impact() -> void:
	var camera := get_viewport().get_camera_2d()
	if camera:
		var base := camera.offset # camera zones may have shifted it
		var tween := create_tween()
		for i in 10:
			var strength := 7.0 * (1.0 - i / 10.0)
			tween.tween_property(camera, "offset", base + Vector2(randf_range(-1, 1), randf_range(-1, 1)) * strength, 0.03)
		tween.tween_property(camera, "offset", base, 0.05)
	if not _clank:
		_clank = _make_clank()
	GameUI.play_sound(self, _clank)


## Placeholder grab sound: noise burst + falling low thump + inharmonic metal ring.
static func _make_clank() -> AudioStreamWAV:
	var stream := AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = 22050
	var count := int(0.45 * stream.mix_rate)
	var data := PackedByteArray()
	data.resize(count * 2)
	var phase := 0.0
	for i in count:
		var t := float(i) / stream.mix_rate
		phase += TAU * (50.0 + 90.0 * exp(-t * 18.0)) / stream.mix_rate
		var thump := sin(phase) * exp(-t * 8.0) * 0.7
		var ring := (sin(TAU * 410.0 * t) + 0.6 * sin(TAU * 1130.0 * t) + 0.4 * sin(TAU * 1870.0 * t)) * exp(-t * 14.0) * 0.18
		var noise := randf_range(-1.0, 1.0) * exp(-t * 60.0) * 0.5
		data.encode_s16(i * 2, int(clampf((thump + ring + noise) * 0.8, -1.0, 1.0) * 32767.0))
	stream.data = data
	return stream
